{
  "expo": {
    "name": "Voleibol Vizcaya",
    "slug": "voleibol-vizcaya",
    "version": "0.3.9",
    "orientation": "portrait",
    "splash": {
      "image": "./assets/Logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "userInterfaceStyle": "automatic",
    "icon": "./assets/Logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.voleibolvizcaya"
    },
    "android": {
      "package": "com.voleibolvizcaya",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.NOTIFICATION_SERVICE"
      ]
    },
    "scheme": "voleibolvizcaya",
    "web": {
      "favicon": "./assets/Logo.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-calendar",
        {
          "calendarPermission": "La app necesita acceso al calendario para guardar recordatorios de partidos.",
          "remindersPermission": "La app necesita acceso a recordatorios para guardar alertas de partidos."
        }
      ],
      "expo-asset",
      [
        "expo-navigation-bar",
        {
          "buttonStyle": "dark"
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-build-properties",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/Logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "image": "./assets/Logo.png",
            "backgroundColor": "#FFFFFF"
          }
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "087cf1fc-428d-44fc-a44f-0f75666b1e14"
      }
    }
  }
}
