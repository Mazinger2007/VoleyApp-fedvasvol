{
  "expo": {
    "name": "Voleibol Vizcaya",
    "slug": "voleibol-vizcaya",
    "version": "0.3.8",
    "jsEngine": "jsc",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/Logo.png",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.personal.voleibolvizcaya"
    },
    "android": {
      "package": "com.personal.voleibolvizcaya",
      "adaptiveIcon": {
        "foregroundImage": "./assets/Logo.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "scheme": "voleibolvizcaya",
    "web": {
      "favicon": "./assets/Logo.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-calendar",
        {
          "calendarPermission": "La app necesita acceso al calendario para guardar recordatorios de partidos.",
          "remindersPermission": "La app necesita acceso a recordatorios para guardar alertas de partidos."
        }
      ],
      "expo-image"
    ]
  }
}
